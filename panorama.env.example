# Copy to ~/.config/panorama/panorama.env, or to panorama.env in the directory
# you start Panorama from. Lookup order: $PANORAMA_ENV, ./panorama.env,
# ~/.config/panorama/panorama.env; the first file found wins.
# Real environment variables override anything set here.

# Directories to scan for git repos. Colon-separated, as many as you like.
PANORAMA_ROOTS=~/work

# Repos that live nowhere near those roots. Listed one by one, never scanned.
# Use this for the odd repo in ~/Downloads or on an external disk.
PANORAMA_REPOS=

# How deep to look for repos under each root. Raise if you nest by client/year.
PANORAMA_SCAN_DEPTH=3

# Claude Code session logs.
PANORAMA_CLAUDE_DIR=~/.claude/projects

# Your notes and todos. Keep this off the code directory so a fresh clone
# never overwrites it, and back it up if you care about the contents.
PANORAMA_DB=~/.local/share/panorama/panorama.db

# Makes ABC-123 in a branch name a clickable link. Leave empty to disable.
PANORAMA_JIRA_BASE=

# Floor on how often git gets shelled out to, in seconds.
PANORAMA_CACHE_SECONDS=3

PORT=8787
